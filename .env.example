# Optional: set this in your shell or deployment environment.
# Local execution is open on 127.0.0.1 unless this is provided.
# .env files are intentionally not loaded automatically.
LEDGERFLOW_ACCESS_TOKEN=replace-with-a-long-private-workspace-code
# LEDGERFLOW_DATA=/absolute/path/to/persistent/storage
# HOST=127.0.0.1
# PORT=8000

# Optional AI reader (Google Gemini). When set, unfamiliar invoice layouts that
# the rule-based extractor cannot parse are read by the model. Every value it
# proposes still passes the same deterministic policy; the model never decides
# the money. Leave blank to run fully deterministic + local OCR, no API needed.
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Comma-separated fallback list; the next model is tried on quota (429), overload (503) or timeout.
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_TIMEOUT=25
# Set to 1 to also double-read invoices the rules read fully (uses quota on every invoice;
# a provider failure then holds even a labelled invoice for review).
# GEMINI_CROSSCHECK=0

# PO line price/amount matching: BOTH limits apply, boundary inclusive.
# Arithmetic allowance remains one minor unit; authorization allowance is zero.
# LEDGERFLOW_MATCH_PERCENT=1
# LEDGERFLOW_MATCH_ABSOLUTE=2.00
